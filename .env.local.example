# ==============================================================================
# EASY ENGLISH TRACKER 30 MIN - FIREBASE CONFIGURATION
# ==============================================================================
# Hướng dẫn kết nối Firebase (Miễn phí 100%):
# 1. Truy cập https://console.firebase.google.com/ và bấm "Add Project" (Tạo dự án mới).
# 2. Vào "Authentication" -> "Get started" -> Bật Sign-in method "Google" và "Anonymous" (Ẩn danh).
# 3. Vào "Firestore Database" -> "Create database" -> Chọn chế độ "Start in production mode".
# 4. Vào "Project settings" (biểu tượng bánh răng) -> Kéo xuống mục "Your apps" -> Bấm biểu tượng Web (</>) để tạo web app.
# 5. Sao chép các khóa cấu hình dưới đây và dán vào tệp .env.local (hoặc đổi tên tệp này thành .env.local).
# ==============================================================================

# Cách 1: Điền từng biến lẻ (Khuyên dùng)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Cách 2: Hoặc dán cả chuỗi JSON cấu hình Firebase (Tùy chọn)
# NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"AIza...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
